# --- Sanity (CMS) ---
# Create a project at https://www.sanity.io/manage, then fill these in.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
# Optional: only needed if you query drafts/private content server-side.
SANITY_READ_TOKEN=

# --- Resend (contact form email) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Address the contact form sends notifications to (your inbox)
CONTACT_TO_EMAIL=hello@wildlandscapeco.com.au
# "From" address — must be a verified domain in Resend, or use
# onboarding@resend.dev while testing
CONTACT_FROM_EMAIL=onboarding@resend.dev
