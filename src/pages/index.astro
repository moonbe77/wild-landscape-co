---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { sanityClient, sanityConfigured, urlFor } from "../lib/sanity";
import { featuredProjectsQuery } from "../lib/queries";
import type { Project } from "../lib/types";
import { placeholderProjects } from "../data/placeholderProjects";

let featured: {
  slug: string;
  title: string;
  category?: string;
  location?: string;
  summary?: string;
  imageUrl: string;
  imageAlt: string;
}[] = [];

if (sanityConfigured) {
  const projects = await sanityClient.fetch<Project[]>(featuredProjectsQuery);
  featured = projects.map((p) => ({
    slug: p.slug,
    title: p.title,
    category: p.category,
    location: p.location,
    summary: p.summary,
    imageUrl: p.coverImage ? urlFor(p.coverImage).width(800).height(600).url() : "",
    imageAlt: p.title,
  }));
}

if (featured.length === 0) {
  featured = placeholderProjects.map((p) => ({
    slug: p.slug,
    title: p.title,
    category: p.category,
    location: p.location,
    summary: p.summary,
    imageUrl: p.coverImageUrl,
    imageAlt: p.title,
  }));
}
---

<BaseLayout
  title="Garden Design & Landscaping — Sunshine Coast"
  description="Wild Landscape Co. designs, builds and maintains gardens across the Sunshine Coast — from courtyard refreshes to full landscaping projects."
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-20 sm:pt-24">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-semibold sm:text-5xl">
        Gardens built for the way you actually live outside.
      </h1>
      <p class="mt-6 text-lg text-moss-600">
        We design, build and maintain landscapes across the Sunshine Coast —
        from a courtyard refresh to a full backyard transformation.
      </p>
      <div class="mt-8 flex gap-4">
        <a
          href="/contact"
          class="rounded-full bg-moss-700 px-6 py-3 text-sm font-semibold text-white hover:bg-moss-800"
        >
          Get a quote
        </a>
        <a
          href="/projects"
          class="rounded-full border border-moss-300 px-6 py-3 text-sm font-semibold text-moss-700 hover:border-moss-500"
        >
          See our work
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-semibold">Recent projects</h2>
      <a href="/projects" class="text-sm font-semibold text-moss-600 hover:text-moss-800">
        View all &rarr;
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => (
        <ProjectCard
          title={project.title}
          slug={project.slug}
          category={project.category}
          location={project.location}
          summary={project.summary}
          imageUrl={project.imageUrl}
          imageAlt={project.imageAlt}
        />
      ))}
    </div>
  </section>

  <section class="bg-moss-100">
    <div class="mx-auto max-w-6xl px-6 py-16 text-center">
      <h2 class="text-2xl font-semibold">Ready to start your project?</h2>
      <p class="mt-3 text-moss-600">
        Tell us about your space and what you're hoping for — we'll get back
        to you within a couple of days.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block rounded-full bg-moss-700 px-6 py-3 text-sm font-semibold text-white hover:bg-moss-800"
      >
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
