---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import StoryStep from "../components/StoryStep.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { sanityClient, sanityConfigured, urlFor } from "../lib/sanity";
import { featuredProjectsQuery } from "../lib/queries";
import type { Project } from "../lib/types";
import { placeholderProjects } from "../data/placeholderProjects";

let featured: {
  slug: string;
  title: string;
  category?: string;
  location?: string;
  summary?: string;
  imageUrl: string;
  imageAlt: string;
}[] = [];

if (sanityConfigured) {
  const projects = await sanityClient.fetch<Project[]>(featuredProjectsQuery);
  featured = projects.map((p) => ({
    slug: p.slug,
    title: p.title,
    category: p.category,
    location: p.location,
    summary: p.summary,
    imageUrl: p.coverImage ? urlFor(p.coverImage).width(800).height(600).url() : "",
    imageAlt: p.coverImage?.alt || p.title,
  }));
}

if (featured.length === 0) {
  featured = placeholderProjects.map((p) => ({
    slug: p.slug,
    title: p.title,
    category: p.category,
    location: p.location,
    summary: p.summary,
    imageUrl: p.coverImageUrl,
    imageAlt: p.title,
  }));
}
---

<BaseLayout
  title="Garden Design & Landscaping — Sunshine Coast"
  description="Wild Landscape Co. designs, builds and maintains gardens across the Sunshine Coast — from courtyard refreshes to full landscaping projects."
  headerVariant="transparent"
>
  <Hero
    eyebrow="Wildlandscapeco."
    title="The experts in outdoor spaces"
    videoSrc="/hero.mp4"
    primaryCta={{ label: "Get a quote", href: "/contact" }}
    secondaryCta={{ label: "View all projects", href: "/projects" }}
  />

  <section data-reveal class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-24">
    <p class="text-xs font-medium tracking-brand uppercase text-moss-500">
      Who we are
    </p>
    <h2 class="mt-4 font-display text-3xl text-moss-900 sm:text-4xl">
      Outdoor spaces, done properly.
    </h2>
    <p class="mt-6 text-lg text-moss-600">
      Wild Landscape Co. designs, builds and maintains gardens across the
      Sunshine Coast. From the first sketch to the final planting — and
      every season after — we handle the whole journey, so your outdoor
      space actually gets used, not just looked at.
    </p>
  </section>

  <div class="divide-y divide-moss-100">
    <StoryStep
      eyebrow="Step one"
      title="Inspire."
      body="We begin with a design consultation on-site, getting to know how
        you actually want to use the space. From there we put together a
        concept — planting, materials, layout — tailored to your style,
        your block, and the way you live outside."
      imageUrl="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1000&q=80"
      imageAlt="Garden design consultation sketch and plans"
    />
    <StoryStep
      eyebrow="Step two"
      title="Create."
      body="Our own team handles the build — hardscaping, planting, lighting,
        water features — start to finish, to the highest standard. No
        subcontracted guesswork: the people who designed it are the people
        building it."
      imageUrl="https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=1000&q=80"
      imageAlt="Landscaping team building a garden feature"
      reverse
    />
    <StoryStep
      eyebrow="Step three"
      title="Maintain."
      body="A new garden is only as good as its upkeep. We offer ongoing
        maintenance so your landscape keeps looking the way it did on
        handover day — through every Sunshine Coast season."
      imageUrl="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=1000&q=80"
      imageAlt="Well-maintained garden landscaping"
    />
  </div>

  <section data-reveal class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-semibold">Recent projects</h2>
      <a href="/projects" class="text-sm font-semibold text-moss-600 hover:text-moss-800">
        View all &rarr;
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => (
        <ProjectCard
          title={project.title}
          slug={project.slug}
          category={project.category}
          location={project.location}
          summary={project.summary}
          imageUrl={project.imageUrl}
          imageAlt={project.imageAlt}
        />
      ))}
    </div>
  </section>

  <CtaBanner
    eyebrow="Let's talk"
    title="Ready to start your project?"
    buttonLabel="Get a quote"
    buttonHref="/contact"
    imageUrl="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1600&q=80"
    imageAlt="Landscaped pool deck at sunset"
  />
</BaseLayout>
