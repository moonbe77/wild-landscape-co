---
interface Props {
  title: string;
  slug: string;
  category?: string;
  location?: string;
  summary?: string;
  imageUrl: string;
  imageAlt: string;
}

const { title, slug, category, location, summary, imageUrl, imageAlt } =
  Astro.props;

const categoryLabels: Record<string, string> = {
  "garden-design": "Garden Design",
  landscaping: "Landscaping",
  hardscaping: "Hardscaping",
  maintenance: "Maintenance",
};
---

<a
  href={`/projects/${slug}`}
  data-reveal
  class="group block overflow-hidden rounded-2xl border border-moss-100 bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <div class="aspect-[4/3] overflow-hidden bg-moss-100">
    <img
      src={imageUrl}
      alt={imageAlt}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    {category && (
      <p class="text-xs font-semibold uppercase tracking-wide text-moss-500">
        {categoryLabels[category] ?? category}
      </p>
    )}
    <h3 class="mt-1 text-lg font-semibold text-moss-800">{title}</h3>
    {location && <p class="mt-1 text-sm text-moss-500">{location}</p>}
    {summary && <p class="mt-3 text-sm text-moss-600 line-clamp-2">{summary}</p>}
  </div>
</a>
