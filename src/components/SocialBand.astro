---
interface Props {
  images: { url: string; alt: string }[];
  instagramUrl?: string;
}

const { images, instagramUrl = "https://www.instagram.com/wildlandscapeco" } =
  Astro.props;
---

<section class="bg-moss-600 py-16">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-2xl font-medium tracking-brand uppercase text-white">
      Social Media
    </h2>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {images.map((image) => (
        <div class="aspect-square overflow-hidden rounded-xl">
          <img
            src={image.url}
            alt={image.alt}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full bg-white px-6 py-3 text-xs font-medium tracking-brand uppercase text-moss-800 hover:bg-sand-50"
      >
        Instagram
      </a>
    </div>
  </div>
</section>
