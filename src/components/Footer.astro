---
import { sanityClient, sanityConfigured } from "../lib/sanity";
import { siteSettingsQuery } from "../lib/queries";
import type { SiteSettings } from "../lib/types";

const year = new Date().getFullYear();

const pageLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Our Work" },
  { href: "/contact", label: "Contact" },
];

const fallbackSettings: Required<Pick<SiteSettings, "email" | "address">> & {
  socialLinks: NonNullable<SiteSettings["socialLinks"]>;
} = {
  email: "hello@wildlandscapeco.com.au",
  address: "Sunshine Coast, Queensland",
  socialLinks: [
    { platform: "Instagram", url: "https://www.instagram.com/wildlandscapeco" },
    { platform: "Facebook", url: "https://www.facebook.com/wildlandscapeco" },
  ],
};

const settings = sanityConfigured
  ? await sanityClient.fetch<SiteSettings | null>(siteSettingsQuery)
  : null;
const email = settings?.email || fallbackSettings.email;
const address = settings?.address || fallbackSettings.address;
const socialLinks = settings?.socialLinks?.length
  ? settings.socialLinks
  : fallbackSettings.socialLinks;
---

<footer class="mt-24 bg-moss-900 text-moss-100">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <p class="font-sans text-sm font-medium tracking-brand uppercase text-white">
      Wild Landscape Co.
    </p>

    <div class="mt-10 grid gap-8 sm:grid-cols-3">
      <div>
        <p class="text-xs font-semibold tracking-brand uppercase text-moss-300">
          Pages
        </p>
        <ul class="mt-3 space-y-2 text-sm text-moss-200">
          {pageLinks.map((link) => (
            <li><a href={link.href} class="hover:text-white">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-brand uppercase text-moss-300">
          Socials
        </p>
        <ul class="mt-3 space-y-2 text-sm text-moss-200">
          {socialLinks.map((social) => (
            <li>
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-white"
              >
                {social.platform}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-brand uppercase text-moss-300">
          Email
        </p>
        <p class="mt-3 text-sm text-moss-200">
          <a href={`mailto:${email}`} class="hover:text-white">
            {email}
          </a>
        </p>
        <p class="mt-4 text-xs font-semibold tracking-brand uppercase text-moss-300">
          Location
        </p>
        <p class="mt-3 text-sm text-moss-200">{address}</p>
      </div>
    </div>
  </div>

  <div class="border-t border-moss-800 py-4 text-center text-xs text-moss-400">
    © {year} Wild Landscape Co. All rights reserved.
  </div>
</footer>
