---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-moss-100 bg-moss-900 text-moss-100">
  <div class="mx-auto max-w-6xl px-6 py-12 grid gap-8 sm:grid-cols-3">
    <div>
      <p class="font-display text-lg text-white">Wild Landscape Co.</p>
      <p class="mt-2 text-sm text-moss-200">
        Garden design, landscaping &amp; maintenance across the Sunshine
        Coast.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Get in touch</p>
      <ul class="mt-2 space-y-1 text-sm text-moss-200">
        <li>
          <a href="mailto:hello@wildlandscapeco.com.au" class="hover:text-white">
            hello@wildlandscapeco.com.au
          </a>
        </li>
        <li>Sunshine Coast, QLD</li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Explore</p>
      <ul class="mt-2 space-y-1 text-sm text-moss-200">
        <li><a href="/projects" class="hover:text-white">Projects</a></li>
        <li><a href="/about" class="hover:text-white">About</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-moss-800 py-4 text-center text-xs text-moss-300">
    © {year} Wild Landscape Co. All rights reserved.
  </div>
</footer>
