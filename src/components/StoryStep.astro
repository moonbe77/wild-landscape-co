---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  imageUrl: string;
  imageAlt: string;
  /** Puts the image on the left instead of the right. */
  reverse?: boolean;
}

const { eyebrow, title, body, imageUrl, imageAlt, reverse = false } =
  Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
  <div
    class:list={[
      "grid items-center gap-10 sm:grid-cols-2 sm:gap-16",
      reverse && "sm:[&>*:first-child]:order-2",
    ]}
  >
    <div>
      <p class="text-xs font-medium tracking-brand uppercase text-moss-500">
        {eyebrow}
      </p>
      <h2 class="mt-3 font-display text-3xl italic text-moss-600 sm:text-4xl">
        {title}
      </h2>
      <p class="mt-5 max-w-md text-moss-600">{body}</p>
    </div>
    <div class="overflow-hidden rounded-2xl">
      <img
        src={imageUrl}
        alt={imageAlt}
        loading="lazy"
        class="aspect-[4/3] h-full w-full object-cover"
      />
    </div>
  </div>
</section>
