---
interface Props {
  eyebrow?: string;
  title: string;
  buttonLabel: string;
  buttonHref: string;
  imageUrl: string;
  imageAlt: string;
}

const { eyebrow, title, buttonLabel, buttonHref, imageUrl, imageAlt } =
  Astro.props;
---

<section class="relative isolate overflow-hidden">
  <img
    src={imageUrl}
    alt={imageAlt}
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-moss-900/50" />

  <div class="mx-auto flex min-h-[420px] max-w-6xl flex-col items-center justify-center px-6 py-24 text-center text-white">
    {eyebrow && (
      <p class="text-xs font-medium tracking-brand uppercase text-moss-100">
        {eyebrow}
      </p>
    )}
    <h2 class="mt-4 max-w-2xl text-3xl font-semibold uppercase tracking-wide text-white sm:text-4xl">
      {title}
    </h2>
    <a
      href={buttonHref}
      class="mt-8 inline-block rounded-full bg-moss-900 px-6 py-3 text-xs font-medium tracking-brand uppercase text-white hover:bg-black"
    >
      {buttonLabel}
    </a>
  </div>
</section>
