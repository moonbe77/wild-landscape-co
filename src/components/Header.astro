---
interface Props {
	/**
	 * "transparent" floats a white-text header over a dark hero (video/photo)
	 * directly beneath it — only use on pages that guarantee a dark top
	 * section, e.g. the home page video hero. Every other page should use
	 * the default "solid" header so nav text stays legible.
	 */
	variant?: "solid" | "transparent";
}

const { variant = "solid" } = Astro.props;

const navLinks = [
	{ href: "/about", label: "About" },
	{ href: "/projects", label: "Projects" },
	{ href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isTransparent = variant === "transparent";
---

<header
  class:list={[
    "z-50 w-full",
    isTransparent
      ? "absolute inset-x-0 top-0"
      : "sticky top-0 border-b border-moss-100 bg-sand-50/90 backdrop-blur",
  ]}
>
  <div
    class:list={[
      "mx-auto flex max-w-7xl items-center justify-between px-6 sm:grid sm:grid-cols-[auto_1fr_auto] sm:gap-8",
      isTransparent ? "py-6 sm:px-10" : "py-5",
    ]}
  >
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <img
        src="/logo-mark-transparent.png"
        alt="Wild Landscape Co."
        width="512"
        height="512"
        class:list={[
          "h-12 w-12 object-contain sm:h-14 sm:w-14",
          isTransparent && "invert",
        ]}
      />
      <span
        class:list={[
          "block whitespace-nowrap font-sans text-[0.68rem] font-medium tracking-brand uppercase sm:hidden lg:block",
          isTransparent
            ? "text-white [text-shadow:0_1px_6px_rgba(0,0,0,0.35)]"
            : "text-moss-800",
        ]}
      >
        Wildlandscapeco.
      </span>
    </a>

    <nav aria-label="Primary" class="hidden justify-self-center sm:block">
      <ul
        class:list={[
          "flex items-center gap-8 text-xs font-medium tracking-brand uppercase",
          isTransparent
            ? "text-white [text-shadow:0_1px_6px_rgba(0,0,0,0.35)]"
            : "text-moss-500",
        ]}
      >
        {navLinks.map((link) => {
          const isActive = currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  isTransparent ? "hover:opacity-70" : "hover:text-moss-600",
                  isActive &&
                    (isTransparent
                      ? "underline underline-offset-4"
                      : "text-moss-800"),
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <a
      href="/contact"
      class:list={[
        "hidden rounded-full px-5 py-2 text-xs font-medium tracking-brand uppercase sm:inline-block",
        isTransparent
          ? "bg-white text-moss-900 hover:bg-sand-100"
          : "bg-moss-900 text-white hover:bg-black",
      ]}
    >
      Get a quote
    </a>

    <details class="group relative sm:hidden">
      <summary
        class:list={[
          "flex h-11 w-11 list-none items-center justify-center rounded-full border [&::-webkit-details-marker]:hidden",
          isTransparent
            ? "border-white/50 text-white"
            : "border-moss-200 text-moss-800",
        ]}
      >
        <span class="sr-only">Toggle navigation</span>
        <span aria-hidden="true" class="relative block h-4 w-5">
          <span class="absolute left-0 top-0 h-px w-5 bg-current transition-transform duration-200 group-open:translate-y-[7px] group-open:rotate-45"></span>
          <span class="absolute left-0 top-[7px] h-px w-5 bg-current transition-opacity duration-200 group-open:opacity-0"></span>
          <span class="absolute bottom-0 left-0 h-px w-5 bg-current transition-transform duration-200 group-open:-translate-y-[7px] group-open:-rotate-45"></span>
        </span>
      </summary>
      <nav
        aria-label="Mobile primary"
        class="absolute right-0 top-full mt-3 w-[min(18rem,calc(100vw-3rem))] origin-top-right rounded-2xl bg-sand-50 p-3 shadow-2xl ring-1 ring-moss-900/10"
      >
        <p class="px-3 pb-2 pt-1 text-[0.65rem] font-semibold tracking-brand uppercase text-moss-500">
          Explore
        </p>
        <ul class="space-y-1 text-base font-medium text-moss-700">
          {navLinks.map((link) => {
            const isActive = currentPath.startsWith(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    "block rounded-xl px-3 py-3 hover:bg-moss-50",
                    isActive && "bg-moss-50 text-moss-900",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
          <li class="pt-2">
            <a
              href="/contact"
              class="block rounded-xl bg-moss-900 px-3 py-3 text-center text-xs tracking-brand uppercase text-white"
            >
              Get a quote
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
