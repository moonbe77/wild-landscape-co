---
interface Props {
  /**
   * "transparent" floats a white-text header over a dark hero (video/photo)
   * directly beneath it — only use on pages that guarantee a dark top
   * section, e.g. the home page video hero. Every other page should use
   * the default "solid" header so nav text stays legible.
   */
  variant?: "solid" | "transparent";
}

const { variant = "solid" } = Astro.props;

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isTransparent = variant === "transparent";
---

<header
  class:list={[
    "z-50 w-full",
    isTransparent
      ? "absolute inset-x-0 top-0"
      : "sticky top-0 border-b border-moss-100 bg-sand-50/90 backdrop-blur",
  ]}
>
  <div
    class:list={[
      "mx-auto flex max-w-7xl items-center justify-between px-6",
      isTransparent ? "py-6 sm:px-10" : "py-5",
    ]}
  >
    <a
      href="/"
      class:list={[
        "flex items-center gap-2",
        isTransparent
          ? "text-white [text-shadow:0_1px_6px_rgba(0,0,0,0.35)]"
          : "text-moss-800",
      ]}
    >
      <span class="font-script text-4xl leading-none" aria-hidden="true">W</span>
      <span class="font-sans text-sm font-medium tracking-brand uppercase">
        Wildlandscapeco.
      </span>
    </a>

    <nav aria-label="Primary" class="hidden sm:block">
      <ul
        class:list={[
          "flex items-center gap-8 text-xs font-medium tracking-brand uppercase",
          isTransparent
            ? "text-white [text-shadow:0_1px_6px_rgba(0,0,0,0.35)]"
            : "text-moss-500",
        ]}
      >
        {navLinks.map((link) => {
          const isActive = currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  isTransparent ? "hover:opacity-70" : "hover:text-moss-600",
                  isActive &&
                    (isTransparent
                      ? "underline underline-offset-4"
                      : "text-moss-800"),
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <a
      href="/contact"
      class:list={[
        "hidden rounded-full px-5 py-2 text-xs font-medium tracking-brand uppercase sm:inline-block",
        isTransparent
          ? "bg-white text-moss-900 hover:bg-sand-100"
          : "bg-moss-900 text-white hover:bg-black",
      ]}
    >
      Get a quote
    </a>

    <details class="relative sm:hidden">
      <summary
        class:list={[
          "flex h-10 w-10 list-none items-center justify-center rounded-full border text-xs font-semibold uppercase [&::-webkit-details-marker]:hidden",
          isTransparent
            ? "border-white/50 text-white"
            : "border-moss-200 text-moss-800",
        ]}
      >
        <span class="sr-only">Open navigation</span>
        <span aria-hidden="true">Menu</span>
      </summary>
      <nav
        aria-label="Mobile primary"
        class="absolute right-0 mt-3 w-56 rounded-2xl bg-sand-50 p-3 shadow-xl ring-1 ring-moss-900/10"
      >
        <ul class="space-y-1 text-sm font-medium text-moss-700">
          {navLinks.map((link) => {
            const isActive = currentPath.startsWith(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    "block rounded-xl px-3 py-2.5 hover:bg-moss-50",
                    isActive && "bg-moss-50 text-moss-900",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
          <li class="pt-2">
            <a
              href="/contact"
              class="block rounded-xl bg-moss-900 px-3 py-2.5 text-center text-xs tracking-brand uppercase text-white"
            >
              Get a quote
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
