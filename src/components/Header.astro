---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Our Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-moss-100 bg-sand-50/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="flex items-center gap-2 text-moss-800">
      <span class="font-display text-2xl italic text-moss-600" aria-hidden="true">
        W
      </span>
      <span class="font-sans text-sm font-medium tracking-brand uppercase">
        Wild Landscape Co.
      </span>
    </a>

    <nav aria-label="Primary" class="hidden sm:block">
      <ul class="flex items-center gap-8 text-xs font-medium tracking-brand uppercase">
        {navLinks.map((link) => {
          const isActive =
            link.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "hover:text-moss-600",
                  isActive ? "text-moss-800" : "text-moss-500",
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <a
      href="/contact"
      class="rounded-full border border-moss-700 px-5 py-2 text-xs font-medium tracking-brand uppercase text-moss-800 hover:bg-moss-700 hover:text-white"
    >
      Get a quote
    </a>
  </div>
</header>
