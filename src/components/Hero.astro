---
interface Cta {
	label: string;
	href: string;
}

interface Props {
	eyebrow: string;
	title: string;
	videoSrc: string;
	posterSrc?: string;
	primaryCta: Cta;
	secondaryCta: Cta;
}

const { eyebrow, title, videoSrc, posterSrc, primaryCta, secondaryCta } =
	Astro.props;
---

<section class="relative isolate flex min-h-screen items-end overflow-hidden bg-moss-900">
  <video
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    poster={posterSrc}
  >
    <source src={videoSrc} type="video/mp4" />
  </video>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 via-black/20 to-black/40" />

  <div data-hero-content class="mx-auto w-full max-w-7xl px-6 pb-16 pt-32 sm:px-10 sm:pb-24">
    <p class="text-xs font-medium tracking-brand uppercase text-white/80">
      {eyebrow}
    </p>
    <h1 class="mt-4 max-w-3xl font-sans text-4xl font-bold uppercase leading-tight text-white sm:text-6xl">
      {title}
    </h1>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={primaryCta.href}
        class="rounded-full bg-moss-900 px-6 py-3 text-xs font-medium tracking-brand uppercase text-white hover:bg-black"
      >
        {primaryCta.label}
      </a>
      <a
        href={secondaryCta.href}
        class="rounded-full border border-white px-6 py-3 text-xs font-medium tracking-brand uppercase text-white hover:bg-white hover:text-moss-900"
      >
        {secondaryCta.label}
      </a>
    </div>
  </div>
</section>
